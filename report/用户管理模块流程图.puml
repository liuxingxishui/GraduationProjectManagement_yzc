@startuml
skinparam backgroundColor #FFFFFF
skinparam handwritten false

skinparam activity {
    BackgroundColor #F5F5F5
    BorderColor #666666
    ArrowColor #333333
    DiamondBackgroundColor #F5F5F5
    DiamondBorderColor #666666
    StartColor #333333
    EndColor #333333
}

skinparam note {
    BackgroundColor #FFFFCC
    BorderColor #999999
}

|用户|
|系统|

|用户|
start
:用户访问系统;
:进入登录页（login.jsp）;
:填写学号（stuID）和密码（stuName）;

|系统|
:后端表单校验;
if (校验通过？) then (否)
    :提示校验失败;
    :返回登录页;
    detach
else (是)
    :查询数据库学生信息;
    if (学生信息匹配？) then (否)
        :提示用户名或密码错误;
        :返回登录页;
        detach
    else (是)
        :学生信息存入 Session;
        :跳转至系统首页（index.jsp）;
        
        |用户|
        :在系统中进行操作;
        :点击退出登录;
        
        |系统|
        :清除 Session 用户登录状态;
        :跳转至系统首页;
        stop
    endif
endif

@enduml
